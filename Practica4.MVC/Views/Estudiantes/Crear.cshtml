@model Practica4.MVC.Models.EstudianteViewModel

@{
    ViewData["Title"] = "Registrar Estudiante";
}

<div class="container py-5">

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

        <div class="estudiantes-header p-4">

            <h2 class="fw-bold text-white mb-1">
                Registrar Estudiante
            </h2>

            <p class="text-white-50 mb-0">
                Complete la información del nuevo estudiante.
            </p>

        </div>

        <div class="card-body p-4">

            <form asp-action="Crear" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <label asp-for="Nombre"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Nombre"
                               class="form-control form-control-lg" />

                        <span asp-validation-for="Nombre"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-4">

                        <label asp-for="Apellido"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Apellido"
                               class="form-control form-control-lg" />

                        <span asp-validation-for="Apellido"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4 mb-4">

                        <label asp-for="Edad"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Edad"
                               class="form-control form-control-lg" />

                        <span asp-validation-for="Edad"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4 mb-4">

                        <label asp-for="Grado"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Grado"
                               class="form-control form-control-lg" />

                        <span asp-validation-for="Grado"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-4 mb-4">

                        <label asp-for="Genero"
                               class="form-label fw-semibold">
                        </label>

                        <select asp-for="Genero"
                                class="form-select form-select-lg">

                            <option value="">
                                Seleccione...
                            </option>

                            <option>
                                Masculino
                            </option>

                            <option>
                                Femenino
                            </option>

                        </select>

                        <span asp-validation-for="Genero"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Cancelar

                    </a>

                    <button class="btn btn-turquesa px-4">

                        <i class="bi bi-check-circle-fill me-2"></i>

                        Guardar

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}