@model Practica4.MVC.Models.EstudianteViewModel

@{
    ViewData["Title"] = "Eliminar Estudiante";
}

<div class="container py-5">

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

        <div class="eliminar-header p-4">

            <h2 class="fw-bold text-white mb-1">
                Eliminar Estudiante
            </h2>

            <p class="text-white-50 mb-0">
                Confirme si desea eliminar este registro.
            </p>

        </div>

        <div class="card-body p-4">

            <div class="alert alert-warning d-flex align-items-center gap-3">

                <i class="bi bi-exclamation-triangle-fill fs-3"></i>

                <div>
                    <strong>Esta acción no se puede deshacer.</strong>

                    <div>
                        El estudiante será eliminado permanentemente.
                    </div>
                </div>

            </div>

            <div class="row g-4 mt-1">

                <div class="col-md-6">
                    <div class="detalle-estudiante">
                        <span class="detalle-etiqueta">
                            Nombre completo
                        </span>

                        <span class="detalle-valor">
                            @Model.Nombre @Model.Apellido
                        </span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="detalle-estudiante">
                        <span class="detalle-etiqueta">
                            Edad
                        </span>

                        <span class="detalle-valor">
                            @Model.Edad años
                        </span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="detalle-estudiante">
                        <span class="detalle-etiqueta">
                            Grado
                        </span>

                        <span class="detalle-valor">
                            @Model.Grado
                        </span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="detalle-estudiante">
                        <span class="detalle-etiqueta">
                            Género
                        </span>

                        <span class="detalle-valor">
                            @Model.Genero
                        </span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="detalle-estudiante">
                        <span class="detalle-etiqueta">
                            Identificador
                        </span>

                        <span class="detalle-valor">
                            #@Model.Id
                        </span>
                    </div>
                </div>

            </div>

            <hr class="my-4" />

            <form asp-action="Eliminar"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary px-4">

                        <i class="bi bi-arrow-left me-2"></i>
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-danger px-4">

                        <i class="bi bi-trash3-fill me-2"></i>
                        Eliminar
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>